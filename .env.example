# ==============================================================================
# PrintQR Environment Variables (.env.local)
# Cyber Cafe / Print Shop: Preeti Communication
# Configure both locally and on Vercel Project Settings > Environment Variables
# ==============================================================================

# Supabase Project URL & Anon Key (Client Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Service Role Key (Server Side / Admin & Print Agent only - Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Shop Base URL (for QR code generator)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
