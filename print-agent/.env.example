# ==============================================================================
# PrintQR Print Agent Configuration (.env)
# Running on shop PC (Preeti Communication)
# ==============================================================================

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Printer Name Mapping (as named in Windows Printers / CUPS)
# Find exact names on Windows: Get-Printer | Select-Object Name
# Find exact names on Linux: lpstat -p
CANON_PRINTER_NAME=Canon_MF3010
BROTHER_PRINTER_NAME=Brother_DCP_T220

# Executable Paths (Optional if added to system PATH)
# On Windows, winget install SumatraPDF.SumatraPDF and winget install TheDocumentFoundation.LibreOffice
SUMATRAPDF_PATH=SumatraPDF.exe
LIBREOFFICE_PATH=soffice

# Agent Configuration
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000
TEMP_DIR=./temp
DRY_RUN=false
